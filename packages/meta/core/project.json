{
  "name": "core",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": ["scope:meta"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "cache": true,
      "inputs": ["{projectRoot}/package.json", "{projectRoot}/README.md"],
      "options": {
        "commands": [
          "mkdir -p dist/packages/meta/core",
          "cp packages/meta/core/package.json packages/meta/core/README.md dist/packages/meta/core/"
        ],
        "parallel": false
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
