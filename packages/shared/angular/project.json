{
  "name": "angular",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/shared/angular/src",
  "prefix": "lib",
  "projectType": "library",
  "release": {
    "version": {
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk",
      "preserveLocalDependencyProtocols": false
    }
  },
  "tags": [],
  "targets": {
    "styles": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/tailwind.config.js"],
      "outputs": ["{projectRoot}/styles.css"],
      "options": {
        "command": "npx @tailwindcss/cli -i packages/shared/angular/src/lib/styles.css -o packages/shared/angular/styles.css"
      }
    },
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/shared/angular/ng-package.json",
        "tsConfig": "packages/shared/angular/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/shared/angular/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production",
      "dependsOn": ["^build", "styles"]
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/shared/angular/jest.config.ts",
        "tsConfig": "packages/shared/angular/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "packages/shared/angular/.storybook",
        "browserTarget": "angular:build-storybook",
        "compodoc": false,
        "styles": ["packages/shared/angular/src/lib/styles.css"]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/angular",
        "configDir": "packages/shared/angular/.storybook",
        "browserTarget": "angular:build-storybook",
        "compodoc": false,
        "styles": ["packages/shared/angular/src/lib/styles.css"]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-storybook"],
      "cache": true,
      "inputs": [
        "{workspaceRoot}/tools/scripts/storybook-smoke.mjs",
        {
          "dependentTasksOutputFiles": "**/*",
          "transitive": false
        }
      ],
      "options": {
        "command": "node tools/scripts/storybook-smoke.mjs --dir dist/storybook/angular"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build-storybook"],
      "options": {
        "buildTarget": "angular:build-storybook",
        "staticFilePath": "dist/storybook/angular",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "angular:build-storybook:ci"
        }
      }
    }
  }
}
