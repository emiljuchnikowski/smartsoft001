{
  "name": "crud-shell-angular-e2e",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/crud/shell/angular-e2e/src",
  "tags": ["scope:crud", "type:e2e"],
  "implicitDependencies": ["crud-shell-angular"],
  "targets": {
    "e2e": {
      "executor": "@nx/cypress:cypress",
      "options": {
        "cypressConfig": "packages/crud/shell/angular-e2e/cypress.config.ts",
        "testingType": "e2e",
        "devServerTarget": "crud-shell-angular:storybook",
        "baseUrl": "http://localhost:4401"
      },
      "configurations": {
        "ci": {
          "devServerTarget": "crud-shell-angular:storybook:ci"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "packages/crud/shell/angular-e2e/**/*.{ts,tsx,js,jsx}"
        ]
      }
    }
  }
}
