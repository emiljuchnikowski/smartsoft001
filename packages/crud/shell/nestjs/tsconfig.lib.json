{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "../../../../dist/out-tsc",
    "declaration": true,
    "types": ["node"],
    "allowSyntheticDefaultImports": true
  },
  "exclude": ["**/*.spec.ts", "**/*.test.ts", "jest.config.ts"],
  "include": ["**/*.ts"],
  "angularCompilerOptions": {
    "strictTemplates": false
  }
}
