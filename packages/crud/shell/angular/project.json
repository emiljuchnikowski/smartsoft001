{
  "name": "crud-shell-angular",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/crud/shell/angular/src",
  "prefix": "smart",
  "tags": ["scope:crud", "type:shell"],
  "generators": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "packages/crud/shell/angular/**/*.{ts,tsx,js,jsx}",
          "packages/crud/shell/angular/package.json"
        ],
        "tsConfig": [
          "packages/crud/shell/angular/tsconfig.lib.json",
          "packages/crud/shell/angular/tsconfig.spec.json"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "packages/crud/shell/angular/jest.config.ts",
        "passWithNoTests": true,
        "tsConfig": "packages/crud/shell/angular/tsconfig.spec.json"
      },
      "outputs": ["{workspaceRoot}/coverage/packages/crud/shell/angular"]
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "styles": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/tailwind.config.js"],
      "outputs": ["{projectRoot}/styles.css"],
      "options": {
        "command": "npx @tailwindcss/cli -i packages/crud/shell/angular/src/lib/styles.css -o packages/crud/shell/angular/styles.css"
      }
    },
    "build": {
      "executor": "@nx/angular:package",
      "options": {
        "tsConfig": "packages/crud/shell/angular/tsconfig.lib.json",
        "project": "packages/crud/shell/angular/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/crud/shell/angular/tsconfig.lib.prod.json"
        }
      },
      "defaultConfiguration": "production",
      "dependsOn": ["^build", "styles"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"]
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4401,
        "configDir": "packages/crud/shell/angular/.storybook",
        "browserTarget": "crud-shell-angular:build-storybook",
        "compodoc": false,
        "styles": [
          "packages/crud/shell/angular/src/lib/styles.css",
          "packages/shared/angular/src/lib/styles.css"
        ]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/crud-shell-angular",
        "configDir": "packages/crud/shell/angular/.storybook",
        "browserTarget": "crud-shell-angular:build-storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-storybook"],
      "cache": true,
      "inputs": [
        "{workspaceRoot}/tools/scripts/storybook-smoke.mjs",
        {
          "dependentTasksOutputFiles": "**/*",
          "transitive": false
        }
      ],
      "options": {
        "command": "node tools/scripts/storybook-smoke.mjs --dir dist/storybook/crud-shell-angular"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build-storybook"],
      "options": {
        "buildTarget": "crud-shell-angular:build-storybook",
        "staticFilePath": "dist/storybook/crud-shell-angular",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "crud-shell-angular:build-storybook:ci"
        }
      }
    }
  }
}
