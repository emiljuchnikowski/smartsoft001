{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "docs/site/src",
  "tags": ["scope:docs", "type:app"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate"],
      "options": {
        "command": "next dev --webpack",
        "cwd": "docs/site"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate"],
      "outputs": ["{projectRoot}/out"],
      "cache": true,
      "inputs": [
        "default",
        "{projectRoot}/src/**/*",
        "{projectRoot}/content/**/*",
        "{workspaceRoot}/docs/examples/**/*",
        "{workspaceRoot}/packages/**/*",
        "{projectRoot}/next.config.mjs",
        "{projectRoot}/postcss.config.js",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/package.json",
        "{projectRoot}/tools/check-export.mjs"
      ],
      "options": {
        "command": "next build --webpack && node tools/check-export.mjs",
        "cwd": "docs/site"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate"],
      "cache": true,
      "inputs": ["default", "{projectRoot}/eslint.config.mjs"],
      "options": {
        "command": "eslint .",
        "cwd": "docs/site"
      }
    },
    "generate-components": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/packages/shared/claude-plugins/src/plugins/smart-angular/skills/angular-components-*/SKILL.md",
        "{workspaceRoot}/packages/shared/claude-plugins/src/plugins/smart-react/skills/react-components-*/SKILL.md",
        "{workspaceRoot}/packages/shared/angular/src/lib/components/**/*.stories.ts",
        "{workspaceRoot}/packages/shared/react/src/lib/components/**/*.stories.tsx",
        "{workspaceRoot}/packages/shared/angular/src/lib/components/index.ts",
        "{workspaceRoot}/docs/examples/angular/src/components/**/*",
        "{workspaceRoot}/docs/examples/react/src/components/**/*",
        "{projectRoot}/content/components/*.md",
        "{projectRoot}/tools/components.mjs",
        "{projectRoot}/tools/check-rules.mjs",
        "{projectRoot}/tools/skills.mjs",
        "{projectRoot}/tools/generate-components.mjs"
      ],
      "outputs": ["{projectRoot}/src/app/docs/components"],
      "options": {
        "command": "node docs/site/tools/generate-components.mjs"
      }
    },
    "generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/app/**/page.md",
        "{projectRoot}/tools/navigation.mjs",
        "{projectRoot}/tools/sections.mjs",
        "{projectRoot}/tools/generate-navigation.mjs"
      ],
      "outputs": ["{projectRoot}/src/lib/navigation.ts"],
      "options": {
        "command": "node docs/site/tools/generate-navigation.mjs"
      },
      "dependsOn": ["generate-components"]
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/docs/site/src/app/**/*",
        "{workspaceRoot}/docs/site/content/**/*",
        "{workspaceRoot}/docs/site/tools/*.mjs",
        "{workspaceRoot}/docs/examples/**/*",
        "{workspaceRoot}/tools/scripts/docs-check.mjs",
        "{workspaceRoot}/packages/**/package.json",
        "{workspaceRoot}/packages/**/*.stories.ts",
        "{workspaceRoot}/packages/**/*.stories.tsx",
        "{workspaceRoot}/packages/shared/angular/src/lib/components/index.ts",
        "{workspaceRoot}/packages/shared/claude-plugins/src/plugins/*/skills/**/SKILL.md",
        "{workspaceRoot}/.claude/skills/**/SKILL.md",
        "{workspaceRoot}/packages/**/.claude/skills/**/SKILL.md",
        "{workspaceRoot}/packages/shared/claude-plugins/src/plugins/*/agents/**/*"
      ],
      "options": {
        "command": "node tools/scripts/docs-check.mjs --strict=R1,R2,R3,R5,R9,R10,R15"
      },
      "dependsOn": ["generate"]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate"],
      "cache": true,
      "inputs": [
        "{projectRoot}/tools/**/*",
        "{workspaceRoot}/tools/scripts/*.mjs",
        "{workspaceRoot}/tools/tsconfig.strict.json",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/packages/**/*.ts",
        "{workspaceRoot}/packages/**/package.json",
        "{workspaceRoot}/packages/**/project.json",
        "{workspaceRoot}/docs/examples/app/**/*",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/.github/workflows/pull-request.yml",
        "{workspaceRoot}/.github/workflows/publish.yml"
      ],
      "options": {
        "command": "node --test docs/site/tools/*.test.mjs tools/scripts/*.test.mjs"
      }
    },
    "install-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash docs/examples/install/install.sh"
      }
    },
    "verify-storybook": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate"],
      "cache": false,
      "options": {
        "command": "node tools/scripts/verify-storybook-ids.mjs"
      }
    }
  }
}
