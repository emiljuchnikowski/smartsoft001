{
  "name": "docs-examples-angular",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "docs/examples/angular/src",
  "projectType": "library",
  "tags": ["scope:docs", "type:examples"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "command": "tsc -p docs/examples/angular/tsconfig.lib.json --noEmit"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "docs/examples/angular/jest.config.ts",
        "tsConfig": "docs/examples/angular/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["docs/examples/angular/**/*.ts"]
      }
    }
  }
}
