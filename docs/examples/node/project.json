{
  "name": "docs-examples-node",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "docs/examples/node/src",
  "projectType": "library",
  "tags": ["scope:docs", "type:examples"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "command": "tsc -p docs/examples/node/tsconfig.lib.json --noEmit"
      }
    },
    "lint": {
      "options": {
        "args": ["\"**/*.ts\""],
        "command": "eslint"
      }
    }
  }
}
