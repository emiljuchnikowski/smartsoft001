{
  "name": "docs-examples-app-web-e2e",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "docs/examples/app/apps/web-e2e/src",
  "tags": ["scope:docs", "type:example-app"],
  "implicitDependencies": ["docs-examples-app-web", "docs-examples-app-api"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "playwright test --config docs/examples/app/apps/web-e2e/playwright.config.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node docs/examples/app/apps/web-e2e/run.mjs"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["docs/examples/app/apps/web-e2e/**/*.{ts,mjs}"]
      }
    }
  }
}
