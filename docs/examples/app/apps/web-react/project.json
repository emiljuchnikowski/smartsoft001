{
  "name": "docs-examples-app-web-react",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "docs/examples/app/apps/web-react/src",
  "tags": ["scope:docs", "type:example-app"],
  "targets": {
    "styles": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/packages/shared/react/src/lib/styles.css",
        "{workspaceRoot}/packages/crud/shell/react/src/lib/styles.css",
        "{workspaceRoot}/tailwind.config.js"
      ],
      "outputs": ["{workspaceRoot}/dist/docs/examples/app/styles-react"],
      "options": {
        "parallel": false,
        "commands": [
          "npx @tailwindcss/cli -i packages/shared/react/src/lib/styles.css -o dist/docs/examples/app/styles-react/react.css",
          "npx @tailwindcss/cli -i packages/crud/shell/react/src/lib/styles.css -o dist/docs/examples/app/styles-react/crud-shell-react.css"
        ]
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "production",
      "cache": true,
      "dependsOn": [
        {
          "target": "styles"
        }
      ],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/docs/examples/app/apps/web-react",
        "forwardAllArgs": false,
        "parallel": false,
        "commands": [
          "tsc -p docs/examples/app/apps/web-react/tsconfig.app.json --noEmit",
          "vite build --config docs/examples/app/apps/web-react/vite.config.ts"
        ]
      },
      "configurations": {
        "production": {},
        "demo": {
          "outputPath": "dist/docs/examples/app/apps/web-react-demo",
          "commands": [
            "tsc -p docs/examples/app/apps/web-react/tsconfig.app.json --noEmit",
            "vite build --config docs/examples/app/apps/web-react/vite.config.ts --mode demo"
          ]
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "styles"
        }
      ],
      "options": {
        "command": "vite --config docs/examples/app/apps/web-react/vite.config.ts"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "build"
        }
      ],
      "options": {
        "command": "vite preview --config docs/examples/app/apps/web-react/vite.config.ts"
      },
      "configurations": {
        "demo": {
          "command": "vite preview --config docs/examples/app/apps/web-react/vite.config.ts --mode demo"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["docs/examples/app/apps/web-react/**/*.{ts,tsx}"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "docs/examples/app/apps/web-react/jest.config.ts",
        "tsConfig": "docs/examples/app/apps/web-react/tsconfig.spec.json"
      }
    }
  }
}
