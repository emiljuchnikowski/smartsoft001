{
  "name": "docs-examples-app-web",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "docs/examples/app/apps/web/src",
  "tags": ["scope:docs", "type:example-app"],
  "targets": {
    "styles": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/packages/shared/angular/src/lib/styles.css",
        "{workspaceRoot}/packages/crud/shell/angular/src/lib/styles.css",
        "{workspaceRoot}/tailwind.config.js"
      ],
      "outputs": ["{workspaceRoot}/dist/docs/examples/app/styles"],
      "options": {
        "parallel": false,
        "commands": [
          "npx @tailwindcss/cli -i packages/shared/angular/src/lib/styles.css -o dist/docs/examples/app/styles/angular.css",
          "npx @tailwindcss/cli -i packages/crud/shell/angular/src/lib/styles.css -o dist/docs/examples/app/styles/crud-shell-angular.css"
        ]
      }
    },
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "dependsOn": [
        {
          "target": "styles"
        }
      ],
      "options": {
        "outputPath": "dist/docs/examples/app/apps/web",
        "browser": "docs/examples/app/apps/web/src/main.ts",
        "tsConfig": "docs/examples/app/apps/web/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "docs/examples/app/apps/web/public"
          }
        ],
        "styles": [
          "dist/docs/examples/app/styles/angular.css",
          "dist/docs/examples/app/styles/crud-shell-angular.css",
          "docs/examples/app/apps/web/src/styles.scss"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "3mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "16kb"
            }
          ],
          "outputHashing": "all"
        },
        "demo": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "3mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "16kb"
            }
          ],
          "outputHashing": "all",
          "baseHref": "/smartsoft001/demo/",
          "outputPath": {
            "base": "dist/docs/examples/app/apps/web-demo/smartsoft001",
            "browser": "demo"
          },
          "fileReplacements": [
            {
              "replace": "docs/examples/app/apps/web/src/app/in-memory/in-memory-api.providers.ts",
              "with": "docs/examples/app/apps/web/src/app/in-memory/in-memory-api.providers.demo.ts"
            },
            {
              "replace": "docs/examples/app/apps/web/src/app/router.features.ts",
              "with": "docs/examples/app/apps/web/src/app/router.features.demo.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "dependsOn": [
        {
          "target": "styles"
        }
      ],
      "options": {
        "port": 4200,
        "proxyConfig": "docs/examples/app/apps/web/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "docs-examples-app-web:build:production"
        },
        "development": {
          "buildTarget": "docs-examples-app-web:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["docs/examples/app/apps/web/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "docs/examples/app/apps/web/jest.config.ts",
        "tsConfig": "docs/examples/app/apps/web/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "docs-examples-app-web:build",
        "staticFilePath": "dist/docs/examples/app/apps/web/browser",
        "spa": true
      },
      "configurations": {
        "demo": {
          "buildTarget": "docs-examples-app-web:build:demo",
          "staticFilePath": "dist/docs/examples/app/apps/web-demo",
          "spa": false
        }
      }
    }
  }
}
